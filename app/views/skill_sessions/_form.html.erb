<%= form_with model: @skill_session, class: 'app-form', data: { controller: 'nested-form' } do |f| %>
  <%= render 'shared/form_errors', record: @skill_session %>
  <section class="panel form-panel">
    <div class="form-grid">
      <div><%= f.label :title, 'Session title (optional)' %><%= f.text_field :title, placeholder: 'Morning practice' %></div>
      <div><%= f.label :date %><%= f.date_field :date, required: true %></div>
      <div><%= f.label :type, 'Activity type' %><%= f.select :type, options_for_select(['Solo Drills', 'Partner Drills', 'Competition', 'Mental Visualization', 'Class', 'Rolls', 'Practice'].union([@skill_session.type].compact), @skill_session.type) %></div>
    </div>
    <div class="form-field"><%= f.label :notes %><%= f.text_area :notes, rows: 3, placeholder: 'What did you work on?', data: { controller: 'textarea-autogrow' } %></div>
  </section>
  <h2 class="section-heading">Activities</h2>
  <div data-nested-form-target="fieldsContainer">
    <%= f.fields_for :activities do |activity| %><%= render 'activity_fields', f: activity %><% end %>
  </div>
  <template data-nested-form-target="template">
    <%= f.fields_for :activities, Activity.new(reps: 1), child_index: 'NEW_RECORD' do |activity| %><%= render 'activity_fields', f: activity %><% end %>
  </template>
  <% if @session_skills.empty? %>
    <p class="flash">Add a skill to this skillset before logging a session. <%= link_to 'Add a skill', new_skill_path %></p>
  <% else %>
    <div class="form-actions"><button type="button" data-action="nested-form#addFields" class="btn-secondary">Add another activity</button><%= f.submit 'Save session', class: 'btn-primary' %></div>
  <% end %>
<% end %>
