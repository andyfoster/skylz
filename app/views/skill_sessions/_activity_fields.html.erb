<section class="nested-fields panel form-panel" data-new-record="<%= f.object.new_record? %>">
  <%= f.hidden_field :_destroy %>
  <div class="form-grid activity-grid">
    <div><%= f.label :skill_id, 'Skill' %><%= f.collection_select :skill_id, @session_skills, :id, :name, { include_blank: 'Choose a skill' }, { required: true } %></div>
    <div><%= f.label :reps, 'Repetitions' %><%= f.number_field :reps, min: 0, required: true %></div>
  </div>
  <fieldset class="rating-field"><legend>How did it go? <span class="muted">(optional, out of 5)</span></legend>
    <div class="rating-options">
      <% [['😞', 'Very bad'], ['😐', 'Bad'], ['😶', 'Neutral'], ['😃', 'Good'], ['😍', 'Very good']].each_with_index do |(emoji, label), index| %>
        <label class="rating-option"><%= f.radio_button :rating, index + 1 %><span><%= emoji %></span><small><%= label %></small></label>
      <% end %>
      <% if f.object.rating.to_i > 5 %><label class="rating-option"><%= f.radio_button :rating, f.object.rating %><small>Legacy: <%= f.object.rating %>/10</small></label><% end %>
    </div>
  </fieldset>
  <div class="form-field"><%= f.label :description, 'Activity notes (optional)' %><%= f.text_area :description, rows: 2, data: { controller: 'textarea-autogrow' } %></div>
  <button type="button" data-action="nested-form#removeFields" class="text-danger">Remove activity</button>
</section>
