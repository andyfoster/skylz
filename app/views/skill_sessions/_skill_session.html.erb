<article id="<%= dom_id skill_session %>" class="panel session-card">
  <div class="section-heading"><h2><%= link_to skill_session.title.presence || "Session · #{skill_session.date&.strftime('%d %b %Y')}", skill_session_path(skill_session) %></h2><%= link_to 'Edit', edit_skill_session_path(skill_session) %></div>
  <p class="muted"><%= skill_session.date&.strftime('%a, %d %b %Y') %> · <%= skill_session.type.presence || 'Practice' %> · <%= pluralize(skill_session.activities.size, 'activity') %> · <%= skill_session.activities.sum { |a| a.reps.to_i } %> reps</p>
  <% if skill_session.notes.present? %><p class="session-notes"><%= simple_format(skill_session.notes) %></p><% end %>
  <ul class="session-activities">
    <% skill_session.activities.each do |activity| %>
      <li><div><%= link_to activity.skill.name, skill_path(activity.skill), class: 'skill-name' %><p><%= activity.description unless activity.description == 'some description' %></p></div><span><%= activity.reps %> reps<% if activity.rating %> · Rating <%= activity.rating %><% end %></span></li>
    <% end %>
  </ul>
</article>
