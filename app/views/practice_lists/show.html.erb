<%= link_to '← Practice lists', practice_lists_path, class: 'back-link' %>
<div class="page-heading"><div><p class="eyebrow">Practice list</p><h1><%= @practice_list.skillset.name %></h1></div></div>
<% if @practice_list.practice_items.empty? %><div class="panel empty-state"><p>Add skills you want to focus on.</p></div><% end %>
<% @practice_list.practice_items.includes(:skill).order(:id).each do |item| %>
  <section class="panel activity-card"><div class="section-heading"><h2><%= link_to item.skill.name, item.skill %></h2><%= link_to 'Log practice', new_skill_session_path(skill_id: item.skill_id), class: 'btn-primary' %></div><%= button_to 'Remove from list', item, method: :delete, class: 'text-danger' %></section>
<% end %>
<% if @available_skills.any? %>
  <%= form_with url: practice_items_path, scope: :practice_item, class: 'panel form-panel app-form' do |form| %>
    <%= form.hidden_field :practice_list_id, value: @practice_list.id %>
    <div class="form-field"><%= form.label :skill_id, 'Add a skill' %><%= form.collection_select :skill_id, @available_skills, :id, :name %></div>
    <%= form.submit 'Add to list', class: 'btn-secondary' %>
  <% end %>
<% end %>
<%= button_to 'Delete practice list', @practice_list, method: :delete, class: 'text-danger', form: { data: { turbo_confirm: 'Delete this list? Your skills and practice history will be kept.' } } %>
