<div class="page-heading"><div><h1>Practice lists</h1><p class="muted">Choose a few skills to focus on next.</p></div><%= link_to 'Create a list', new_practice_list_path, class: 'btn-primary' %></div>
<% if @practice_lists.empty? %><div class="panel empty-state"><h2>No practice lists yet</h2><p>Create one for a skillset and add the skills you want to practice.</p></div><% end %>
<% @practice_lists.each do |list| %><section class="panel detail-panel"><h2><%= link_to list.skillset.name, list %></h2><p class="muted"><%= pluralize(list.practice_items.size, 'skill') %> to practice</p></section><% end %>
