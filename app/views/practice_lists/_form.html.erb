<%= form_with model: practice_list, class: 'app-form panel form-panel' do |form| %>
  <%= render 'shared/form_errors', record: practice_list %>
  <div class="form-field"><%= form.label :skillsets_id, 'Skillset' %><%= form.collection_select :skillsets_id, current_user.skillsets.order(:name), :id, :name %></div>
  <p class="muted">Each skillset can have one practice list.</p>
  <div class="form-actions"><%= form.submit 'Create list', class: 'btn-primary' %><%= link_to 'Cancel', practice_lists_path %></div>
<% end %>
