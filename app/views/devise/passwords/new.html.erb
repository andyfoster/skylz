<div class="panel form-panel auth-card app-form">
  <h1>Reset your password</h1><p class="muted">Enter your email to request reset instructions.</p>
  <%= form_for resource, as: resource_name, url: password_path(resource_name), html: { method: :post } do |f| %>
    <%= render 'shared/form_errors', record: resource %>
    <div class="form-field"><%= f.label :email %><%= f.email_field :email, autofocus: true, autocomplete: 'email', required: true %></div>
    <%= f.submit 'Send reset instructions', class: 'btn-primary' %>
  <% end %>
  <p class="muted form-field"><%= link_to 'Back to login', new_user_session_path %></p>
</div>
