<div class="panel form-panel auth-card app-form">
  <h1>Welcome back</h1><p class="muted">Log in to your skills and practice history.</p>
  <%= form_for resource, as: resource_name, url: session_path(resource_name), html: { data: { turbo: false } } do |f| %>
    <div class="form-field"><%= f.label :email %><%= f.email_field :email, autofocus: true, autocomplete: 'email', required: true %></div>
    <div class="form-field"><%= f.label :password %><%= f.password_field :password, autocomplete: 'current-password', required: true %></div>
    <% if devise_mapping.rememberable? %><div class="remember-me"><%= f.check_box :remember_me %><%= f.label :remember_me, 'Remember me' %></div><% end %>
    <div class="form-actions"><%= f.submit 'Log in', class: 'btn-primary' %><%= link_to 'Forgot your password?', new_user_password_path %></div>
  <% end %>
  <p class="muted">New to Skylz? <%= link_to 'Create an account', new_user_registration_path %></p>
</div>
