<div class="panel form-panel auth-card app-form">
  <h1>Create an account</h1><p class="muted">Build a library of skills you want to keep fresh.</p>
  <%= form_for resource, as: resource_name, url: registration_path(resource_name), html: { data: { turbo: false } } do |f| %>
    <%= render 'shared/form_errors', record: resource %>
    <div class="form-field"><%= f.label :email %><%= f.email_field :email, autofocus: true, autocomplete: 'email', required: true %></div>
    <div class="form-field"><%= f.label :password %><%= f.password_field :password, autocomplete: 'new-password', required: true, minlength: @minimum_password_length %><p class="muted"><%= @minimum_password_length %> characters minimum.</p></div>
    <div class="form-field"><%= f.label :password_confirmation, 'Confirm password' %><%= f.password_field :password_confirmation, autocomplete: 'new-password', required: true %></div>
    <div class="form-actions"><%= f.submit 'Register', class: 'btn-primary' %></div>
  <% end %>
  <p class="muted">Already have an account? <%= link_to 'Log in', new_user_session_path %></p>
</div>
