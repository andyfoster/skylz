<div class="page-heading"><div><p class="eyebrow"><%= @current_skillset.name %></p><h1>Your progress</h1><p class="muted">Based on the dates you practiced.</p></div></div>
<div class="stat-grid"><% [['Reps this week', @reps_this_week], ['Activities this week', @num_activities_this_week], ['Sessions this week', @sessions_this_week], ['Activities all time', @num_activities]].each do |label, value| %><div class="panel stat"><span class="muted"><%= label %></span><strong><%= value %></strong></div><% end %></div>
<% if @num_activities.zero? %><div class="panel empty-state"><h2>Your progress starts with one session</h2><p>Log some practice to see your charts here.</p><%= link_to 'Log session', new_skill_session_path, class: 'btn-primary' %></div><% else %>
<div class="chart-grid">
  <section class="panel chart-panel"><h2>Reps by week</h2><%= line_chart @total_reps_by_week, height: '240px' %></section>
  <section class="panel chart-panel"><h2>Activity types</h2><%= pie_chart @activity_types_count, height: '240px' %></section>
  <section class="panel chart-panel"><h2>Activities by week</h2><%= column_chart @activities_by_week, height: '240px' %></section>
  <section class="panel chart-panel"><h2>Average ratings</h2><%= bar_chart @avg_rating_per_skill, height: '240px' %></section>
</div>
<% end %>
