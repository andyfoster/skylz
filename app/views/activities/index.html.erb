<div class="page-heading"><div><p class="eyebrow"><%= @skillset.name %></p><h1>Activity log</h1></div><%= link_to 'Log session', new_skill_session_path, class: 'btn-primary' %></div>
<% if @activities.empty? %><div class="panel empty-state"><h2>No activity yet</h2><p>Your practice will appear here after you log a session.</p></div><% end %>
<% @activities.reverse.each do |activity| %>
<section class="panel activity-card"><div class="section-heading"><h2><%= link_to activity.skill.name, skill_path(activity.skill) %></h2><%= link_to 'Edit', edit_skill_activity_path(activity.skill, activity) %></div><p class="muted"><%= (activity.date || activity.created_at.to_date).strftime('%d %b %Y') %> · <%= activity.reps %> reps · <%= activity.activity_type.presence || 'Practice' %></p><%= simple_format(activity.description) unless activity.description == 'some description' %></section>
<% end %>
