<%= form_with model: [@skill, activity], class: 'app-form panel form-panel' do |form| %>
  <%= render 'shared/form_errors', record: activity %>
  <div class="form-grid"><div><%= form.label :date %><%= form.date_field :date, required: true %></div><div><%= form.label :activity_type, 'Activity type' %><%= form.select :activity_type, options_for_select(['Solo Drills', 'Partner Drills', 'Competition', 'Mental Visualization', 'Class', 'Rolls', 'Practice'].union([activity.activity_type].compact), activity.activity_type) %></div><div><%= form.label :reps, 'Repetitions' %><%= form.number_field :reps, min: 0, required: true %></div></div>
  <div class="form-field"><%= form.label :rating, 'Rating (optional)' %><%= form.select :rating, options_for_select((1..5).map { |value| ["#{value}/5", value] } + (activity.rating.to_i > 5 ? [["Legacy rating: #{activity.rating}/10", activity.rating]] : []), activity.rating), include_blank: 'Not rated' %></div>
  <div class="form-field"><%= form.label :description, 'How did it go?' %><%= form.text_area :description, rows: 4 %></div>
  <div class="form-field"><%= form.label :tags %><%= form.text_field :tags, placeholder: 'Tags separated by commas' %></div>
  <%= form.submit 'Save activity', class: 'btn-primary' %>
<% end %>
