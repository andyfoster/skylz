<div class="page-heading">
  <div><p class="eyebrow"><%= @skillset.name %></p><h1>Your practice overview</h1><p class="muted">Keep the skills you care about fresh.</p></div>
  <%= link_to 'Add a skill', new_skill_path, class: 'btn-secondary' %>
</div>
<div class="stat-grid">
  <% [['Skills', @num_skills], ['Activities this week', @num_activities_this_week], ['Reps this week', @reps_this_week], ['Activities all time', @num_activities]].each do |label, value| %>
    <div class="panel stat"><span class="muted"><%= label %></span><strong><%= value %></strong></div>
  <% end %>
</div>
<div class="section-heading"><h2>Your skills</h2><%= link_to 'Search and filter →', skills_path %></div>
<%= render 'skills/list', skills: @skills %>
<% if @avg_rating_per_skill.present? %>
  <section class="panel chart-panel"><h2>Average ratings</h2><%= bar_chart @avg_rating_per_skill, height: "240px" %></section>
<% end %>
