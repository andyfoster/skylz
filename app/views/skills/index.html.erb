<div class="page-heading"><div><p class="eyebrow"><%= @skillset.name %></p><h1>Your skills</h1></div><%= link_to 'Add a skill', new_skill_path, class: 'btn-primary' %></div>
<%= form_with url: skills_path, method: :get, class: 'panel filter-bar' do |form| %>
  <div><%= form.label :q, 'Search skills' %><%= form.search_field :q, value: params[:q], placeholder: 'Name or notes' %></div>
  <div><%= form.label :tag, 'Tag' %><%= form.select :tag, options_for_select(@tags, params[:tag]), include_blank: 'All tags' %></div>
  <div><%= form.label :sort, 'Sort by' %><%= form.select :sort, options_for_select([['Most reps', 'reps'], ['Name', 'name'], ['Recently practiced', 'recent']], params[:sort] || 'reps') %></div>
  <%= form.submit 'Apply', class: 'btn-primary' %>
  <%= link_to 'Clear', skills_path %>
<% end %>
<p class="muted result-count"><%= pluralize(@skills.size, 'skill') %> · <%= link_to 'Add several skills at once', new_multi_path %></p>
<%= render 'list', skills: @skills %>
