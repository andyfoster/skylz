<article id="<%= dom_id skill %>" data-controller="toggle">
  <div class="page-heading"><div><p class="eyebrow"><%= skill.skillset.name %></p><h1><%= skill.name %></h1></div><%= link_to 'Edit skill', edit_skill_path(skill), class: 'btn-secondary' %></div>
  <% history = skill.activities.sort_by { |activity| [activity.date || activity.created_at.to_date, activity.id] }.reverse %>
  <div class="stat-grid"><div class="panel stat"><span class="muted">Total reps</span><strong><%= skill.total_reps %></strong></div><div class="panel stat"><span class="muted">Activities</span><strong><%= history.size %></strong></div><div class="panel stat"><span class="muted">Last practiced</span><strong class="stat-date"><%= history.first ? (history.first.date || history.first.created_at.to_date).strftime('%d %b %Y') : 'Not yet' %></strong></div></div>
  <div class="tag-list"><% skill.tags.to_s.split(',').map(&:strip).reject(&:blank?).each do |tag| %><%= link_to tag, skills_path(tag: tag), class: 'tag' %><% end %></div>
  <% if skill.reason.present? %><section class="panel detail-panel"><h2>When to use</h2><p><%= skill.reason %></p></section><% end %>
  <% if skill.notes.present? %><section class="panel detail-panel"><h2>Notes</h2><%= markdown(skill.notes) %></section><% end %>
  <% if skill.steps.present? %>
    <section class="panel detail-panel">
      <h2>Steps</h2>
      <p class="muted step-hint">Click a step to mark it done. Click again to undo.</p>
      <% step_number = 0 %>
      <ul class="skill-steps">
        <% skill.steps.lines.map(&:strip).reject(&:blank?).each do |step| %>
          <% if step.start_with?('*') %>
            <li class="step-heading"><%= step.sub(/^\*\s*/, '') %></li>
          <% else %>
            <% step_number += 1 %>
            <li>
              <button type="button" class="skill-step" aria-pressed="false" data-action="toggle#lineThrough">
                <span class="step-number"><%= step_number %></span>
                <span class="step-text"><%= step %></span>
              </button>
            </li>
          <% end %>
        <% end %>
      </ul>
    </section>
  <% end %>
  <% if skill.media.present? %><section class="panel detail-panel"><h2>Resources</h2><% skill.media.lines.map(&:strip).reject(&:blank?).each do |url| %><% if url.match?(/\Ahttps?:\/\//i) %><p><%= link_to url, url, target: '_blank', rel: 'noopener noreferrer' %></p><% else %><p><%= url %></p><% end %><% end %></section><% end %>
  <div class="section-heading"><h2>Activity log</h2><%= link_to 'Log practice', new_skill_session_path(skill_id: skill.id), class: 'btn-primary' %></div>
  <% if history.empty? %><div class="panel empty-state"><p>No practice logged yet.</p></div><% end %>
  <% history.each do |activity| %>
    <section class="panel activity-card"><div class="section-heading"><strong><%= activity.reps %> reps</strong><%= link_to 'Edit activity', edit_skill_activity_path(skill, activity) %></div><p class="muted"><%= (activity.date || activity.created_at.to_date).strftime('%a, %d %b %Y') %> · <%= activity.activity_type.presence || 'Practice' %><% if activity.rating %> · Rating <%= activity.rating %><% end %></p><% if activity.description.present? && activity.description != 'some description' %><%= simple_format(activity.description) %><% end %></section>
  <% end %>
</article>
