<div data-controller="skill-form" class="app-form">
  <%= form_with model: skill do |form| %>
    <%= render 'shared/form_errors', record: skill %>
    <section class="panel form-panel">
      <div class="form-field"><%= form.label :name %><%= form.text_field :name, required: true, data: { skill_form_target: 'skillNameInput' } %></div>
      <div class="form-actions"><button type="button" data-action="skill-form#generate" data-skill-form-target="generateButton" class="btn-secondary" <%= 'disabled' if ENV['OPENAI_API_KEY'].blank? %>>✨ Generate draft with AI</button><p class="muted" data-skill-form-target="status" role="status"><%= 'AI drafting is unavailable until OPENAI_API_KEY is configured.' if ENV['OPENAI_API_KEY'].blank? %></p></div>
      <% [['reason', 'When to use', false], ['notes', 'Notes', true], ['steps', 'Steps (one per line; * starts a section)', true], ['tags', 'Tags (separated by commas)', false], ['media', 'Resource links (one per line)', true]].each do |field, label, multiline| %>
        <div class="form-field"><%= form.label field, label %><% targets = { 'reason' => 'skillReasonInput', 'notes' => 'skillNotesInput', 'steps' => 'skillStepsInput', 'tags' => 'skillTagsInput' } %>
          <% if multiline %><%= form.text_area field, rows: 4, data: { skill_form_target: targets[field], controller: 'textarea-autogrow' } %><% else %><%= form.text_field field, data: { skill_form_target: targets[field] } %><% end %>
        </div>
      <% end %>
      <div class="form-field"><%= form.label :skillset_id, 'Skillset' %><%= form.collection_select :skillset_id, current_user.skillsets.order(:name), :id, :name, selected: skill.skillset_id || @skillset.id %></div>
      <div class="form-actions"><%= form.submit 'Save skill', class: 'btn-primary' %><%= link_to 'Cancel', skill.persisted? ? skill_path(skill) : skills_path %></div>
    </section>
  <% end %>
  <% if skill.persisted? %><%= button_to 'Delete skill', skill, method: :delete, class: 'text-danger', form: { data: { turbo_confirm: 'Delete this skill and its activities?' } } %><% end %>
</div>
